    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
