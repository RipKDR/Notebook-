{
  "name": "@loom/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --experimental-sqlite src/server.ts",
    "start": "node --experimental-sqlite dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "token": "tsx --experimental-sqlite src/token-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@loom/core": "workspace:*",
    "hono": "^4.6.14",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@loom/db": "workspace:^",
    "@types/node": "^22.10.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
