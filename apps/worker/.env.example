# The worker holds the model credential so the phone never has to.
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret for verifying client bearer tokens. Without it the worker
# refuses every authenticated route rather than trusting the caller.
# Generate one with: pnpm --filter @loom/worker token --secret
LOOM_TOKEN_SECRET=

# Optional. Without it the worker falls back to the local trigram embedder,
# which works offline but clusters noticeably worse.
VOYAGE_API_KEY=

# Where persisted quota counters live.
USAGE_DB=./loom-usage.db

# Where compile jobs live. Jobs are durable: a restart mid-compile resumes from
# the last stage boundary rather than destroying work the user paid for. Point
# this at a volume that survives a deploy.
JOBS_DB=./loom-jobs.db

PORT=8787
COMPILE_CONCURRENCY=2
